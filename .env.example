# PulseML Environment Configuration
# Copy to .env and edit before running

# Server
DEBUG=false
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Database (default: SQLite in data/)
DATABASE_URL=sqlite:///./data/pulseml.db

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Drift detection thresholds
KS_DRIFT_THRESHOLD=0.1
PSI_DRIFT_THRESHOLD=0.2
CHISQ_PVALUE_THRESHOLD=0.05
PERFORMANCE_DROP_THRESHOLD=0.05

# Minimum samples required for drift analysis
MIN_SAMPLES=50
